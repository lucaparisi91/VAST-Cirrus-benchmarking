#!Jinja2

[scheduler]

        
    allow implicit tasks = True

    ########## INPUT PARAMETERS ############
    {% from "benchmarks" import load_benchmark %}
    # Matrix of parameters. A task will be created for each combination of parameters.
    {% set parameters = load_benchmark( benchmark_config ) %}
    # Result directory
    {%
        set results_dir = "/work/d435/d435/lparisid435/met-lfric-cirrus/results/"
    %}

    # Machine Parameters
    {%
        set coresPerNode = 288
    %}

    # Number of times to repeat each experiment (to get an estimate of variability)
    {%
        set repeats = 1
    %}

    {% 
        set dependencies_modules_path = "/work/z19/z19/lparisi/nfs-testing/benchmark_env/modules"
    %}


    ########## WORKFLOW DEFINITIONS ############
    [[events]]
        stall timeout = PT1H30M

    
    {% from "parameters" import expand_combinations, get_label,remove_key %}
    {% from "generate_config" import generate_posix_config %}
    
    {% set combinations = expand_combinations(parameters, repeats) %}

[scheduling]
    [[queues]]
        # Allow only one benchmark to run at the same time, to avoid interference between jobs.
        [[[run_benchmark_queue]]]
            limit = 1
            members = RUN_BENCHMARK
    
    [[graph]]
        
        {% for combination in combinations %}
        R1= """
            setup_iobenchmark_{{get_label(combination)}} &
             {% if combination.operation == "read" %}
                => &
                run_iobenchmark_{{get_label(combination | update({"operation": "write"})) }} &
            {% endif %}
                => run_iobenchmark_{{get_label(combination)}} => clean_up_io_benchmark_{{ get_label(remove_key(combination, "operation")) }}
        """
        {% endfor %}

[runtime]
            # Collection of all tasks
                [[ALL]]
            
            # Group tasks that run the benchmark, to separate them from setup and cleanup tasks.
                [[ RUN_BENCHMARK]]
                    inherit = ALL
             # Group tasks that run the benchmark, to separate them from setup and cleanup tasks.
                [[ ANALYSIS]]
                    inherit = ALL
            {% for combination in combinations %}
                [[ setup_iobenchmark_{{ get_label(combination) }} ]]
                    platform = localhost
                    script = """
                            set -e
                            # Working directory for the job
                            WORKDIR=$CYLC_WORKFLOW_SHARE_DIR/iobenchmark_{{ get_label(combination) }}
                            mkdir -p $WORKDIR
                            
                            {% if combination.filesystem == "lustre" %} 
                                IO_PATH=/work/z19/z19/lparisi/nfs-testing/runs/data/{{ get_label(combination) }}
                            {% elif combination.filesystem == "vast" %} 
                                IO_PATH=/vast/lparisi/data/{{ get_label(combination) }}
                            {% endif %}


                            cd $WORKDIR
                            
                            # Loop over each parameter in the combination and pass the parameter as arguments to a python script
                            python3 -m generate_config \
                                --node={{ combination.nodes }} \
                                --tasksPerNode={{ combination.tasksPerNode }} \
                                {% if combination.chunkSize %} --chunkSize={{ combination.chunkSize }} {% endif %} \
                                {% if combination.chunksPerTask %} --chunksPerTask={{ combination.chunksPerTask }} {% endif %} \
                                {% if combination.direct %} --direct {% endif %} \
                                {% if combination.singleFile %} --singleFile     {% endif %} \
                                --repeat={{ combination.repeat }} \
                                --output=$WORKDIR/config.yaml \
                                --path=${IO_PATH} \
                                --operation={{ combination.operation }} \
                                --alignment={{ combination.alignment }} \
                                {% if combination.strided %} --strided {% endif %} \
                                {% if combination.randomStrided %} --randomStrided   --maxRandomStride={{ combination.maxRandomStride }} {% endif %}

                            """
                
                [[ run_iobenchmark_{{ get_label(combination) }} ]]
                    platform = cirrus
                    inherit = RUN_BENCHMARK
                    script = """

                            set -e
                            WORKDIR=$CYLC_WORKFLOW_SHARE_DIR/iobenchmark_{{ get_label(combination) }}
                            cd $WORKDIR
                            
                            module load PrgEnv-gnu
                            #module use {{ dependencies_modules_path }}
                            
                            # Libfabric env variables for Slingshot-11
                            export FI_CXI_RX_MATCH_MODE=hybrid
                            #export FI_CXI_OPTIMIZED_MRS=false
                            export FI_CXI_DEFAULT_CQ_SIZE=1048576
                            
                            export SRUN_CPUS_PER_TASK=$SLURM_CPUS_PER_TASK
                            export OMP_PLACES=cores
                            export OMP_PROC_BIND=close

                            EXEC=/work/z19/z19/lparisi/nfs-testing/cbenchio/opt/cbenchio/dev/bin/benchio
                            
                            
                            {% if combination.filesystem == "lustre" %} 
                                IO_PATH={{ get_io_path("/work/z19/z19/lparisi/nfs-testing/runs/data", combination) }}
                            {% elif combination.filesystem == "vast" %} 
                                IO_PATH={{ get_io_path("/vast/lparisi/data", combination) }}
                            {% endif %}

                            rm -rf $IO_PATH/* # Clean up any existing data in the directory, to avoid interference with the benchmark results.
                            mkdir -p $IO_PATH # Create directory where to write/read the data

                            {% if combination.filesystem == "lustre" %} 
                                {% if combination.stripes > 1 %}
                                    lfs setstripe -C {{ combination.stripes }} -S {{ combination.chunkSize }}K $IO_PATH
                                {% endif %}

                            {% endif %}

                            srun --mem=0 --hint=nomultithread --distribution=block:block $EXEC $WORKDIR/config.yaml
                            
                            """
                    [[[directives]]]
                        --nodes = {{ combination.nodes }}
                        --ntasks-per-node = {{ combination.tasksPerNode }}
                        --cpus-per-task = {{ coresPerNode // combination.tasksPerNode }}
                        --time = 00:40:00
                        --partition = standard
                        --reservation = VAST
                        --account = z19
                        --qos = reservation
                        --exclusive = 
                
                [[ cleanup_io_benchmark_{{ get_label(combination) }} ]]
                    platform = localhost
                    script = """
                            
                            # Working directory for the job
                            WORKDIR=$CYLC_WORKFLOW_SHARE_DIR/iobenchmark_{{ get_label(combination) }}
                            {% if combination.filesystem == "lustre" %} 
                                IO_PATH={{ get_io_path("/work/z19/z19/lparisi/nfs-testing/runs/data", combination) }}
                            {% elif combination.filesystem == "vast" %} 
                                IO_PATH={{ get_io_path("/vast/lparisi/data", combination) }}
                            {% endif %}

                            # Clean up the data created by the benchmark, to save space and avoid interference with future runs.
                            rm -rf $IO_PATH/*
                            """    

    {%endfor %}                    
    